<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E14">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/setupView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔧 Backend Setup"
                    android:textColor="#EEF2F7"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Backend check ho raha hai…"
                    android:textColor="#FBBF24"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="NAYA tareeqa (v2): engine ab app ke ANDAR hai — References tab se model download karo, Termux ki zaroorat khatam. Ye Setup sirf purane Termux backend ke liye hai:"
                    android:textColor="#94A3B8"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Step 1 — Termux install karo (backend wahi chalta hai)"
                    android:textColor="#EEF2F7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnInstallTermux"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Termux Install Karo (F-Droid)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Step 2 — Termux kholo aur ye ek command paste karo (ye backend environment install kare gi — pehli dafa 10-20 minute lag sakte hain, Wi-Fi par karna)"
                    android:textColor="#EEF2F7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyCmd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Setup Command Copy Karo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Step 3 — Backend chalao"
                    android:textColor="#EEF2F7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnStartBackend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Backend Start Karo" />

                <Button
                    android:id="@+id/btnCheckBackend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Backend Check Karo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Remote backend bhi chal sakta hai: Settings me ja kar apna server/tunnel URL dal do — phir Termux ki zaroorat nahi."
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/settingsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Settings"
                    android:textColor="#EEF2F7"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Backend URL (local Termux ke liye default hi rakho; remote server/tunnel ho to us ka URL dal do)"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#EEF2F7"
                    android:textColorHint="#64748B"
                    android:hint="http://127.0.0.1:8000"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnSaveBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Save + Dobara Check Karo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="📜 Backend Logs (kisi bhi waqt)"
                    android:textColor="#EEF2F7"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Logs Refresh Karo" />

                <TextView
                    android:id="@+id/logsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Logs yahan ayenge…"
                    android:textColor="#A7F3EA"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/refsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼 Meri References"
                    android:textColor="#EEF2F7"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ye wo images hain jin ko system internet par dhundhe ga. Har image add hone par us ki pehchan (embedding) phone par hi ban kar save ho jati hai."
                    android:textColor="#94A3B8"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/modelStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Model check ho raha hai…"
                    android:textColor="#FBBF24"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnDownloadModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⬇ Model Download Karo (ek dafa)" />

                <Button
                    android:id="@+id/btnAddRef"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="➕ Reference Images Add Karo" />

                <TextView
                    android:id="@+id/refsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="References: 0"
                    android:textColor="#EEF2F7"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/refsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/aiView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI — Deep Research"
                    android:textColor="#EEF2F7"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AI OPTIONAL hai — core system bagher AI ke bhi mukammal chalta hai. AI sirf results ki deep research/analysis ke liye hai. Apna kisi bhi platform ka Base URL + API Key dal do (OpenAI-compatible)."
                    android:textColor="#94A3B8"
                    android:textSize="13.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresetRouter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OpenRouter"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPresetApmix"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Apmix"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPresetOpenAi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="OpenAI"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Base URL"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editAiBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#EEF2F7"
                    android:textColorHint="#64748B"
                    android:hint="https://openrouter.ai/api/v1"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="API Key (phone par encrypted save hoti hai)"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editAiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#EEF2F7"
                    android:textColorHint="#64748B"
                    android:hint="sk-…"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Model ka naam"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editAiModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#EEF2F7"
                    android:textColorHint="#64748B"
                    android:hint="masalan: openai/gpt-4o-mini"
                    android:inputType="text"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnAiSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="💾 AI Setting Save Karo" />

                <Button
                    android:id="@+id/btnAiFetch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Models Ki List Lao" />

                <Button
                    android:id="@+id/btnAiTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="AI Test Karo" />

                <TextView
                    android:id="@+id/aiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI status yahan ayega…"
                    android:textColor="#A7F3EA"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1420"
        android:padding="6dp">

        <Button
            android:id="@+id/navScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔎 Scan"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navRefs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🖼 Refs"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navAi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🤖 AI"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navSetup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🔧 Setup"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="⚙️ Settings"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
